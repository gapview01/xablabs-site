---
import Base from '../../layouts/Base.astro';
import pieces from '../../data/celebveg.json';
import Mascot from '../../components/MascotParsnip.astro';
import mint from '../../data/mint.json';

const title = 'CelebVeg — History’s greatest figures have been… reduced.';
const description =
  "Photorealistic long-dead historical figures turned into vegetables, fruit and objects. Wave 1: 10 pieces on Solana at 1 SOL each. Early is best.";
---

<Base title={title} description={description} image="/assets/banner_v3.jpg">
  <section class="hero bg-blobs">
    <div class="container layout">
      <div>
        <span class="badge">By Xab Labs</span>
        <h1>History, but make it veg.</h1>
        <p class="lede">Deadpan icons. Photoreal. On Solana.</p>
        <div class="cta">
          <span class="badge-cream">2,000 total • 3% royalties • Metaplex Core</span>
          <a class="btn" href="/celebveg/mint">Mint — {mint.priceSol} SOL</a>
          <a class="btn secondary" href="#cast">See the collection</a>
        </div>
      </div>
      <Mascot size="lg" />
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__item">NAPOLEON BONAPART-SNIP</span>
      <span class="marquee__item">CLEOPEACHTRA</span>
      <span class="marquee__item">ABRAHAM LIME-COLN</span>
      <span class="marquee__item">ARCHIMEDEAS</span>
      <span class="marquee__item">VINCENT VAN GRAPE</span>
      <span class="marquee__item">JOAN OF KALE</span>
      <span class="marquee__item">ALEXANDER THE GRATE</span>
      <span class="marquee__item">FRANCIS BACON</span>
      <span class="marquee__item">SIR FRANCIS DRAKE</span>
      <span class="marquee__item">LUDWIG VAN BEET</span>
      <span class="marquee__item">History’s greatest figures have been… reduced.</span>
    </div>
  </div>

  <section class="container mt-6" id="cast">
    <h2 class="section-title">Meet the cast</h2>
    <p class="mt-2 mb-6">Wave 1 — 10 pieces at {mint.priceSol} SOL. Early is best.</p>

    <div class="grid">
      {pieces.map((p, i) => (
        <article class="card piece reveal" data-index={i}>
          <a href={"#piece-" + p.id} class="open-lightbox" aria-label={"Open " + p.name}>
            <div class="frame wobble tilt3d">
              <div class="inner">
                <img
                  src={p.thumb}
                  alt={p.name}
                  loading="lazy"
                  width="720"
                  height="720"
                  style="aspect-ratio:1/1; object-fit:cover;"
                />
              </div>
            </div>
          </a>
          <div class="meta">
            <div class="name">{p.name}</div>
            <div class="desc">{p.shortDescription || p.description}</div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container mt-10">
    <h2 class="section-title">Waves</h2>
    <div class="waves">
      <div class="wave live reveal">
        <div class="dot" aria-hidden="true"></div>
        <div class="content">
          <div class="label">Wave I — live</div>
          <div class="note">10 pieces at {mint.priceSol} SOL. Early is best.</div>
        </div>
      </div>
      <div class="wave coming reveal">
        <div class="dot" aria-hidden="true"></div>
        <div class="content">
          <div class="label">Wave II — coming</div>
          <div class="note">Costs more. More plentiful.</div>
        </div>
      </div>
      <div class="wave coming reveal">
        <div class="dot" aria-hidden="true"></div>
        <div class="content">
          <div class="label">Waves III–n — coming</div>
          <div class="note">Reduced. Funny. Rising price.</div>
        </div>
      </div>
    </div>
  </section>

  <section class="container mt-8">
    <h2 class="section-title">Mint</h2>
    <p class="mt-2">Live now. {mint.priceSol} SOL. Early is best.</p>
    <div class="mt-3" style="display:flex; flex-wrap:wrap; gap:12px;">
      <a class="btn" href="/celebveg/mint">Mint — {mint.priceSol} SOL</a>
    </div>
  </section>

  <section class="container mt-10 reveal">
    <div class="trustbar" role="note" aria-label="Trust and verification">
      <div class="row">
        <div><strong>Collection</strong></div>
        <code class="mono" id="collection-address">CFuLSYMno9vMaiGUkkMHVyrpwhJcdCXMunVpaNAMmZTC</code>
        <a class="btn secondary" target="_blank" rel="noopener" href="https://explorer.solana.com/address/CFuLSYMno9vMaiGUkkMHVyrpwhJcdCXMunVpaNAMmZTC">View on Solana Explorer</a>
        <button class="btn copy" type="button" data-copy="#collection-address">Copy</button>
      </div>
      <div class="row" style="color:#cbd5e1">
        <div>Price {mint.priceSol} SOL • Paid to Xab Labs • 3% royalties • Metaplex Core • Arweave storage • <a href="https://x.com/xablabs" target="_blank" rel="noopener" style="color:white; text-decoration:underline;">@xablabs</a></div>
      </div>
    </div>
  </section>

  <section class="container mt-10 center">
    <p class="mt-3">
      Follow <a class="btn secondary" href="https://x.com/xablabs" target="_blank" rel="noopener">@xablabs</a>
    </p>
    <p class="mt-2 muted">CelebVeg by Xab Labs</p>
  </section>

  <div id="lightbox-root"></div>

  <script define:vars={{ pieces, price: mint.priceSol }}>
    // Copy helper
    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const sel = (btn as HTMLElement).getAttribute('data-copy')!;
        const el = document.querySelector(sel);
        if (!el) return;
        const text = (el.textContent || '').trim();
        try {
          await navigator.clipboard.writeText(text);
          (btn as HTMLButtonElement).textContent = 'Copied';
          window.setTimeout(() => ((btn as HTMLButtonElement).textContent = 'Copy'), 1200);
        } catch {}
      });
    });

    const root = document.getElementById('lightbox-root')!;
    function open(index) {
      const p = pieces[index];
      if (!p) return;
      root.innerHTML = `
      <div class="lightbox" role="dialog" aria-modal="true" aria-labelledby="lb-title">
        <div class="panel">
          <header>
            <h3 id="lb-title">${p.name}</h3>
            <button class="btn secondary" data-close-lightbox>Close</button>
          </header>
          <div class="body">
            <div class="img"><img src="${p.image}" alt="${p.name}" /></div>
            <div class="details">
              <div class="badge-cream">Wave 1 • ${price} SOL • 3% royalties</div>
              <p class="mt-3">${p.description}</p>
              <div class="attrs mt-4">
                ${(p.attributes || [])
                  .map(
                    (a) => `<div class="attr"><strong>${a.trait_type || a.traitType}:</strong> ${a.value}</div>`
                  )
                  .join('')}
              </div>
              <div class="mt-6" style="display:flex; gap:10px; flex-wrap:wrap;">
                <a class="btn" href="/celebveg/mint">Mint — ${price} SOL</a>
              </div>
            </div>
          </div>
        </div>
      </div>`;
      const closeBtn = root.querySelector('[data-close-lightbox]');
      closeBtn?.addEventListener('click', () => {
        root.innerHTML = '';
        history.replaceState(null, '', location.pathname + location.search);
      });
    }

    // Expose for testing/screenshot tooling
    // @ts-ignore
    window.__openLightbox = open;

    document.querySelectorAll('.open-lightbox').forEach((el, idx) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        open(idx);
        history.replaceState(null, '', '#piece-' + pieces[idx].id);
      });
    });

    // Open from hash
    if (location.hash.startsWith('#piece-')) {
      const id = location.hash.replace('#piece-', '');
      const idx = pieces.findIndex((p) => String(p.id) === id);
      if (idx >= 0) open(idx);
    }
  </script>

  <script>
    // Lightweight 3D tilt for framed cards
    const els = document.querySelectorAll<HTMLElement>('.tilt3d');
    els.forEach((el) => {
      el.addEventListener('mousemove', (e) => {
        const rect = el.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        const rx = (0.5 - y) * 8;
        const ry = (x - 0.5) * 12;
        el.style.setProperty('--rx', rx.toFixed(2) + 'deg');
        el.style.setProperty('--ry', ry.toFixed(2) + 'deg');
      });
      el.addEventListener('mouseleave', () => {
        el.style.removeProperty('--rx');
        el.style.removeProperty('--ry');
      });
    });
  </script>
</Base>

