---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = 'Xab Labs — NFT Co. Revitalising NFTs with fresh, powerful stories.',
  description = 'Xab Labs creates entertainment-first NFT collections. Bold, fast, and funny.',
  image = '/assets/banner_v3.jpg',
} = Astro.props as Props;
const absoluteImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Titan+One&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Xab Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:url" content={Astro.url.href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
  </head>
  <body>
    <header class="site">
      <div class="container wrap">
        <a class="brand" href="/">Xab Labs</a>
        <nav>
          <a href="/celebveg">CelebVeg</a>
          <a href="/celebveg/mint">Mint</a>
          <a href="https://x.com/xablabs" target="_blank" rel="noopener">X</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="container row">
        <div>
          <strong>Xab Labs</strong> — NFT Co. Revitalising NFTs with fresh, powerful stories.
        </div>
        <div class="muted">Follow <a href="https://x.com/xablabs" target="_blank" rel="noopener">@xablabs</a></div>
      </div>
    </footer>
  </body>
  <script is:inline>
    // Close lightbox on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('[data-close-lightbox]').forEach((el) => {
          (el as HTMLButtonElement).click();
        });
      }
    });
  </script>
</html>

